{
  "manifest_version": 3,
  "name": "Tidy Tab Groups",
  "version": "1.0.0",
  "description": "Groups a tab with the tab it was opened from, and disbands groups left with one tab, without touching groups made by AI agents.",
  "permissions": ["tabs", "tabGroups", "storage", "webNavigation", "favicon"],
  "background": { "service_worker": "background.js" },
  "options_ui": { "page": "options.html", "open_in_tab": false },
  "action": { "default_title": "Tidy Tab Groups", "default_popup": "options.html" },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
